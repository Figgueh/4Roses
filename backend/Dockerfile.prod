# Use Puppeteer base image
FROM ghcr.io/puppeteer/puppeteer:latest

WORKDIR /app

# Install dependencies as root
USER root

COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Build your app (production build)
RUN npm run build

# After build, remove devDependencies
RUN npm prune --production

# Give ownership to pptruser
RUN chown -R pptruser:pptruser /app

# Run as non-root (Cloud Run requirement)
USER pptruser

EXPOSE 3001

# Start the production server
CMD ["npm", "start"]
