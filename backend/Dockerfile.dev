# Use official Puppeteer image (includes Chromium deps)
FROM ghcr.io/puppeteer/puppeteer:latest

# Set Puppeteer to use downloaded Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/home/pptruser/.cache/puppeteer/chrome-headless-shell/linux-141.0.7390.78/chrome-headless-shell-linux64/chrome-headless-shell

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 3001

# Ensure permissions and launch
CMD ["sh", "-c", "chmod -R 755 /home/pptruser/.cache/puppeteer && ls -R /home/pptruser/.cache/puppeteer && npm run dev"]
