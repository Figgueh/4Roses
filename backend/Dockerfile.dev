# Use official Puppeteer image as base
FROM ghcr.io/puppeteer/puppeteer:latest

WORKDIR /app

USER root

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Explicitly download browser using puppeteer
# This creates /home/pptruser/.cache/puppeteer/chrome-headless-shell/...
RUN npm exec puppeteer@latest browsers install chrome

# Verify browser was downloaded
RUN ls -la /home/pptruser/.cache/puppeteer/ || echo "Browser cache not found yet"

# Copy application code
COPY . .

# Fix permissions
RUN chown -R pptruser:pptruser /app /home/pptruser

# Switch to non-root user
USER pptruser

# Verify browser is accessible by pptruser
RUN ls -la /home/pptruser/.cache/puppeteer/chrome-headless-shell/ || echo "Checking browser..."

EXPOSE 3001

CMD ["npm", "run", "dev"]