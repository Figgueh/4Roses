# Use official Puppeteer image
FROM ghcr.io/puppeteer/puppeteer:latest

# Work in a neutral directory
WORKDIR /app

# Use root to install node_modules during build
USER root

COPY package*.json ./
RUN npm install

# Install Chrome/Chromium explicitly
RUN apt-get update && apt-get install -y chromium-browser && apt-get clean

# Also download via puppeteer to ensure it's cached
RUN npx puppeteer@latest browsers install chrome

# Copy source files
COPY . .

# Give ownership back to pptruser for Cloud Run execution
RUN chown -R pptruser:pptruser /app

# Switch back to pptruser (Cloud Run requires non-root)
USER pptruser

EXPOSE 3001

CMD ["npm", "run", "dev"]
