# Use official Puppeteer image
FROM ghcr.io/puppeteer/puppeteer:latest

# Set Puppeteer to use downloaded Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/home/pptruser/.cache/puppeteer/chrome-headless-shell/linux-141.0.7390.78/chrome-headless-shell-linux64/chrome-headless-shell

# Switch to pptruser (already default, but explicit is safe)
USER pptruser

# Set a writable working directory for pptruser
WORKDIR /home/pptruser/app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy the rest of the app
COPY --chown=pptruser:pptruser . .

EXPOSE 3001

# Start the app
CMD ["npm", "run", "dev"]
