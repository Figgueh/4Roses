# Use official Puppeteer image
FROM ghcr.io/puppeteer/puppeteer:latest

WORKDIR /app

USER root

COPY package*.json ./
RUN npm install

# Download browser using puppeteer - this is the key step
RUN npx puppeteer@latest browsers install chrome

# Install minimal dependencies that Chrome needs
RUN apt-get update && apt-get install -y \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN chown -R pptruser:pptruser /app

USER pptruser

EXPOSE 3001

CMD ["npm", "run", "dev"]